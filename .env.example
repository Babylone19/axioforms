# Serveur API
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Base de données (docker-compose fournit Postgres sur le port 5433 — 5432 occupé en local)
DATABASE_URL=postgres://axioforms:axioforms@localhost:5433/axioforms

# Secret utilisé pour hacher les clés d'API (HMAC-SHA256) — à changer en prod
API_KEY_PEPPER=change-me-in-production

# Stockage des pièces jointes
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=10485760

# Origine autorisée pour l'admin (CORS)
ADMIN_ORIGIN=http://localhost:5173
